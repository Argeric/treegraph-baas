	<build>
    	<finalName>treegraph-baas</finalName>
    	<plugins>
    		<plugin>
	            <groupId>org.springframework.boot</groupId>
	            <artifactId>spring-boot-maven-plugin</artifactId>
	        </plugin>   
    	</plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                	<exclude>simkai.ttf</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                	<include>simkai.ttf</include>
                </includes>
            </resource>
            <resource>
                <directory>${profiles.dir}/${package.env}</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>


    <!-- profiles多环境处理 -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <package.env>dev</package.env>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                    <!-- <version>${spring-boot.version}</version> -->
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>test</id>
            <properties>
                <package.env>test</package.env>
            </properties>
        </profile>

        <profile>
            <id>prod</id>
            <properties>
                <package.env>prod</package.env>
            </properties>
        </profile>
        
        <profile>
            <id>container</id>
            <properties>
                <package.env>container</package.env>
            </properties>
        </profile>
    </profiles>
</project>
